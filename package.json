{
  "name": "Assistant",
  "version": "1.0.0",
  "description": "Assistant",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "codegen": "bash codegen.sh",
    "build": "tsc",
    "start:server": "node dist/mcp-data-server/mcp-server.js",
    "dev:server": "tsx src/mcp-data-server/mcp-server.ts",
    "dev:agent": "cmd /C \"set OPENCODE_CONFIG=./opencode.json && opencode --port 3000 web --hostname 127.0.0.1\""
  },
  "dependencies": {
    "@genql/runtime": "^2.10.0",
    "@modelcontextprotocol/client": "2.0.0-alpha.3",
    "@modelcontextprotocol/express": "2.0.0-alpha.3",
    "@modelcontextprotocol/node": "2.0.0-alpha.3",
    "@modelcontextprotocol/server": "2.0.0-alpha.3",
    "axios": "1.18.1",
    "dotenv": "17.2.4",
    "express": "5.2.1",
    "graphql": "16.10.0",
    "jsonrepair": "3.14.1",
    "openai": "6.44.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@genql/cli": "^2.10.0",
    "@types/express": "5.0.0",
    "@types/node": "22.0.0",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "concurrently": "10.0.3",
    "prettier": "3.2.5",
    "tsx": "4.19.0",
    "typescript": "6.0.3"
  }
}

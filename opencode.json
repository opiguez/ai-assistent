{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": ["node_modules/**", "src/agent(archived)/**"]
  },
  "mcp": {
    "web-mcp_data": {
      "type": "remote",
      "url": "http://127.0.0.1:3002/mcp",
      "enabled": true
    },
    "web-mcp_bpmn": {
      "type": "remote",
      "url": "http://127.0.0.1:3003/mcp",
      "enabled": true
    }
  },
  "agent": {
    "orchestrator": {
      "description": "Координатор проектов low-code системы. Работает ТОЛЬКО через MCP-подагентов plan-execute/build-execute.",
      "mode": "primary",
      "default": true,
      "agents": ["plan-execute", "build-execute"],
      "allowedTools": [
        "data_*",
        "bpmn_*",
        "save_tasks_queue",
        "complete_current_task"
      ],
      "prompt": "{file:./src/promts/orchestrator.md}"
    },
    "plan-execute": {
      "description": "Веб-Архитектор. Декомпозиция ТЗ в очередь задач",
      "mode": "subagent",
      "prompt": "{file:./src/promts/planner.md}",
      "allowedTools": ["data_*", "bpmn_*", "save_tasks_queue"]
    },
    "build-execute": {
      "description": "Веб-Инженер. Выполняет задачи из очереди по HTTP",
      "mode": "subagent",
      "prompt": "{file:./src/promts/engineer.md}",
      "allowedTools": ["data_*", "bpmn_*", "complete_current_task"]
    }
  },
  "default_agent": "orchestrator"
}
